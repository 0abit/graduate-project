# Copy this file to .env, then fill in real values.
# Do not commit .env.

# ============================================================
# Database
# ============================================================
# Local MongoDB example:
# MONGO_URI=mongodb://localhost:27017/
# MongoDB Atlas example:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/
DB_NAME=nlp_biology_db

# Neo4j Aura example:
# NEO4J_URI=neo4j+s://<database-id>.databases.neo4j.io
NEO4J_URI=neo4j+s://<database-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASS=<neo4j-password>

# ============================================================
# API keys
# ============================================================
# Use comma-separated Gemini keys if the pipeline needs key rotation.
# Example: GEMINI_KEYS=key_1,key_2,key_3
GEMINI_KEYS=<gemini-api-key-1>,<gemini-api-key-2>

# Optional. If empty, Cohere rerank falls back to RRF-only results.
COHERE_API_KEY=<cohere-api-key>

# Optional. Used when uploading textbook images to Cloudinary.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Firebase Admin SDK is not read from an env var in the current code.
# Put firebase-adminsdk.json at the project root when running the web API.
SUPER_ADMIN_EMAIL=admin@example.com

# ============================================================
# Data paths
# ============================================================
CURRENT_BOOK=sinh_hoc_12
DATA_DIR=data
PDF_DIR=data/raw_data
MD_DIR=data/processed_md
OCR_DIR=data/ocr
OCR_IMAGE_DIR=data/ocr/images
OCR_JSON_DIR=data/ocr/json
METADATA_DIR=data/metadata
CHECKPOINT_DIR=data/checkpoints
STOP_FILE=data/STOP_PIPELINE
EXTRACTED_IMAGE_DIR=src/static/extracted_images

# ============================================================
# Gemini models
# ============================================================
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_CHAT_MODEL=gemini-3-flash-preview
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2
CHATBOT_TEMPERATURE=0.1

# ============================================================
# Phase 1 OCR config
# ============================================================
# CPU is safer for a low-VRAM machine such as GTX 1050.
PHASE1_OCR_MODE=paddle_vietocr
PADDLE_OCR_LANG=vi
PADDLE_OCR_VERSION=PP-OCRv4
PADDLE_DEVICE=cpu
PADDLE_USE_TEXTLINE_ORIENTATION=true
PADDLE_PDF_DPI=220
PHASE1_FORCE_REOCR=false
PADDLE_ENABLE_MKLDNN=false

VIETOCR_CONFIG=vgg_transformer
VIETOCR_DEVICE=cpu
VIETOCR_BEAMSEARCH=false
VIETOCR_CROP_PADDING=4
PHASE1_KEEP_PADDLE_TEXT=false

# ============================================================
# Phase 2 chunking config
# ============================================================
CHUNK_MAX_CHARS=3500
INCLUDE_OUT_OF_TOC_PAGES=false
OBJECTIVE_SCAN_PAGES=2
PHASE2_FORCE_METADATA_REEXTRACT=true

# ============================================================
# Phase 3 knowledge extraction config
# ============================================================
BATCH_SIZE=3
SLEEP_TIME=300
KEY_SLEEP_TIME=180
PHASE3_KEY_GROUP_SIZE=3
PHASE3_GROUP_SLEEP_TIME=180
PHASE3_ALL_KEYS_EXHAUSTED_SLEEP_TIME=3600
PHASE3_JSON_RETRY_COUNT=2
PHASE3_JSON_RETRY_SLEEP_TIME=5
PHASE3_TRANSIENT_RETRY_COUNT=3
PHASE3_TRANSIENT_RETRY_SLEEP_TIME=30
PHASE3_SKIP_CHUNK_ON_JSON_ERROR=true

# ============================================================
# Phase 5 embedding config
# ============================================================
PHASE5_BATCH_SIZE=3
PHASE5_SLEEP_TIME=180
PHASE5_ERROR_SLEEP_TIME=180
